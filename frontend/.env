
# Copy to .env and fill in -- Vite bakes VITE_-prefixed vars into the
# build, so this ships inside the frontend's JS bundle. It's not a true
# secret (anyone loading the page could find it in devtools), but it does
# stop a stranger who finds the deployed backend's URL directly (without
# going through your frontend at all) from hitting the LLM-calling routes.
#
# Must match API_SHARED_SECRET in backend/.env exactly. Leave both unset
# for local development -- the backend only enforces this check when its
# side is actually configured.
VITE_API_SHARED_SECRET="watermelons_under_bridge"